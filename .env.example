# Site
NEXT_PUBLIC_SITE_URL=https://investorscircle.in
NEXT_PUBLIC_SITE_NAME=Investors Circle

# Contact / WhatsApp (leave empty to hide WhatsApp FAB)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=hello@investorscircle.in
NEXT_PUBLIC_CONTACT_PHONE=

# Lead form endpoint (Formspree, custom webhook, CRM API, etc.)
# Required for form submissions on static Hostinger deploys.
NEXT_PUBLIC_FORM_ENDPOINT=

# Analytics — leave empty until ready (do not hardcode IDs in source)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Deployment mode:
# - omit or "export"  → static `out/` for Hostinger shared / static hosting
# - "standalone"      → Node server for Hostinger VPS / Cloud with Node
NEXT_OUTPUT=export
