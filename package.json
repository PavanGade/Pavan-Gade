    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^30.4.2",
    "jest-expo": "^57.0.3",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
